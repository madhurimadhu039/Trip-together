# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL EXTERNAL TRAVEL PROVIDER CREDENTIALS
# If unconfigured, TripTogether automatically operates in Verified Reference / Demo Adapter mode
# and links directly to official booking portals (IRCTC, APSRTC, APTDC, TTD) without inventing live availability.
IRCTC_RAPIDAPI_KEY=""
REDBUS_PARTNER_API_KEY=""
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
HOTELBEDS_API_KEY=""

# REAL EMAIL DELIVERY CONFIGURATION (Requirement 10)
# Configure recipient and SMTP credentials (e.g. Gmail, Outlook, Amazon SES, SendGrid, Mailgun)
# Messages submitted through Contact Us will be delivered to CONTACT_RECIPIENT_EMAIL.
CONTACT_RECIPIENT_EMAIL="madhurimadhu039@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
